{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kynisto",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "kynisto.in/*", "custom_domain": true },
    { "pattern": "www.kynisto.in/*", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  }
}
